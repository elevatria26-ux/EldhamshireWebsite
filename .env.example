# ============================================================
# SUPABASE
# ============================================================
# Project URL from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public key — safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role key — NEVER expose to browser (server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# RESEND (Email)
# ============================================================
# API key from resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The "from" email address (must be a verified domain in Resend)
RESEND_FROM_EMAIL=elevatria26@gmail.com

# Reply-to address
RESEND_REPLY_TO=elevatria26@gmail.com

# ============================================================
# GOOGLE ANALYTICS
# ============================================================
# GA4 Measurement ID from Google Analytics → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================
# APP CONFIG
# ============================================================
# The canonical URL of this site (no trailing slash)
NEXT_PUBLIC_APP_URL=https://eldhamshire.com

# Site name for metadata
NEXT_PUBLIC_SITE_NAME=Eldhamshire
